# =============================================================================
# COMPRESS-X STUDIO — ENVIRONMENT CONFIGURATION
# =============================================================================

PORT=3000

# -----------------------------------------------------------------------------
# SUPABASE CLOUD DATABASE & AUTH CONFIGURATION
# 1. Sign up / Log in to https://supabase.com
# 2. Create a new Project (or select existing)
# 3. Go to Project Settings > API
# 4. Copy 'Project URL' into SUPABASE_URL below
# 5. Copy 'anon / public' key into SUPABASE_ANON_KEY below
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase service_role key for backend admin operations
SUPABASE_SERVICE_ROLE_KEY=
